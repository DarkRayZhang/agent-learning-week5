# ===== W5 Embedding 服务（与 chat 模型分开！）=====
# ⚠️ 认知点：DeepSeek 官方 API 不提供 embedding 端点（2026-08 实测 /embeddings 返回 404），
#    chat 模型厂商 ≠ 一定有 embedding 服务。以下二选一，注册拿 key 后填入。
#
# 方案 A（推荐）：阿里云百炼 text-embedding-v4（有免费额度）
#   注册：bailian.console.aliyun.com → 右上角头像 → API-KEY 管理
#   叙事价值：百炼是 D12 目标生态之一，提前积累使用手感
# 方案 B：硅基流动 SiliconFlow BGE-M3（有免费额度）
#   注册：cloud.siliconflow.cn → API Keys

# —— 方案 A（默认）——
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# —— 方案 B（用 B 就注释掉上面三行、放开下面三行）——
# EMBEDDING_API_KEY=sk-xxxx
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3

# 可选：chat 模型 key（W5 卫星项目不用聊天模型；W6 RAG 需要，可直接从 week4/.env 抄）
DEEPSEEK_API_KEY=
